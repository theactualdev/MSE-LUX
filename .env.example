# Copy to .env and fill in real values. Every variable is validated or read
# server-side; see README.md for what each one does and what breaks without it.

# --- Database (Supabase Postgres) ---
# Pooled connection, used by the running app.
DATABASE_URL=postgresql://user:password@host:6543/postgres
# Direct (non-pooled) connection, used ONLY by prisma.config.ts for migrations.
DIRECT_URL=postgresql://user:password@host:5432/postgres

# --- Supabase auth ---
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# --- Site identity ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=MSE Lux

# --- Paystack (payments) ---
PAYSTACK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxx

# --- ShipBubble (courier rates + labels) ---
SHIPBUBBLE_API_KEY=sb_xxx
SHIPBUBBLE_ORIGIN_ADDRESS_CODE=your-validated-pickup-address-code
SHIPBUBBLE_CATEGORY_ID=0
SHIPBUBBLE_QUOTE_SECRET=generate-a-long-random-secret

# --- Resend (transactional email) ---
RESEND_API_KEY=re_xxx
EMAIL_FROM=orders@your-domain

# --- Upstash Redis (rate limiting; fails open when unset) ---
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# --- Cron ---
CRON_SECRET=generate-a-long-random-secret

# --- Site gate (pre-launch privacy curtain) ---
# When set, EVERY storefront route requires this password (server-enforced in
# src/proxy.ts; admin, webhooks and cron are exempt — see features/gate/gate.ts).
# Server-side only: never NEXT_PUBLIC_. Changing it revokes every existing
# gate session. REMOVING it and redeploying makes the site public — that is
# the launch switch.
SITE_PASSWORD=your-password-here
